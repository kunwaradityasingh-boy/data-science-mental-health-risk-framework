# ================================
# Python
# ================================
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ================================
# Virtual Environment
# ================================
.venv/
venv/
env/

# ================================
# Environment / Secrets
# ================================
.env
.env.*
!.env.example

# ================================
# Jupyter
# ================================
.ipynb_checkpoints/

# ================================
# Data
# ================================
# Raw datasets: ignore dataset files, but track dataset folders and READMEs
data/raw/*
!data/raw/**/
!data/raw/**/README.md
data/processed/*
data/synthetic/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# ================================
# Machine Learning Artifacts
# ================================
models/**/*.pkl
models/**/*.joblib
models/**/*.h5
models/**/*.pt
models/**/*.pth
models/**/*.onnx


# Public Streamlit demo model
!models/text_baseline/
!models/text_baseline/*.joblib

# ================================
# Logs
# ================================
*.log
logs/

# ================================
# OS
# ================================
.DS_Store
Thumbs.db
desktop.ini

# ================================
# IDE
# ================================
.vscode/
.idea/

# ================================
# Temporary Files
# ================================
*.tmp
*.temp
*.bak
*.swp

# ================================
# Test / Coverage
# ================================
.pytest_cache/
.coverage
htmlcov/

# ================================
# Build
# ================================
build/
dist/
*.egg-info/

# Never track raw dataset archives
*.zip

# Extracted raw dataset files
data/raw/**/extracted/

# Raw research source artifacts
data/raw/**/inspection/

